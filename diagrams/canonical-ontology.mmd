flowchart TB

  %% Layer 1 - Human
  subgraph L1["Layer 1 - Human (Blue)"]
    direction TB
    H[Human Agent (H)\n- sovereign meaning/value origin\n- regret owner\n- traits: HSS, SCP]
    AS[Alignment Surface (AS)\n- low to high fidelity interfaces]
    I[Structured Intent Object (I)\n- goal statement\n- output spec\n- regret tolerance\n- constraint seed C0\n- budget envelope B]
  end

  %% Layer 2 - Engine
  subgraph L2["Layer 2 - Symbiosis Engine (Green)"]
    direction TB
    E[Symbiosis Engine (E)\nDeterministic coordinator\nRouter / Planner / Economic Pass / Safety Supervisor]
    TG[Task Graph (TG)\nTyped nodes + dependencies + checkpoints]
    AB[Autonomy Band (AB0-AB3)\nEnforced autonomy ceiling]
    RB[Regret Boundary (RB)\nReversibility threshold]
    EC[Economic Circuit (EC)\nBudget gate]
  end

  %% Layer 3 - Agentic
  subgraph L3["Layer 3 - Agentic (Yellow)"]
    direction TB
    MCP[MCP Contracts\nCapabilities / permissions / AB ceiling / cost caps]
    A[Agent Clusters\nCapability modules\nNo goal authority]
  end

  %% Layer 4 - Governance
  subgraph L4["Layer 4 - Governance (Red)"]
    direction TB
    GK[Governance Kernel (GK)\nRisk classes / RB-AB rules\nConstraint supremacy]
    C[Constraint Vector (C)\nC_legal, C_safety, C_econ\nHard boundary]
    P[Policy Engine / Boards\nSector overlays / audits / escalations]
  end

  %% Lineage Spine
  L[Context Lineage (L)\nImmutable spine\nHashes + replayability]

  %% DOWNWARD control flow
  H --> AS --> I --> E
  E --> EC --> TG
  E --> RB --> AB
  E --> TG --> MCP --> A

  %% UPWARD telemetry
  A -. "telemetry" .-> E
  E -. "lineage updates" .-> L
  E -. "SI/HSS/SCP deltas" .-> H
  E -. "audit metrics" .-> P

  %% Constraints injection
  P --> GK --> C
  C --> E
  C --> TG
  C --> MCP

  %% Styling
  classDef blue fill:#dbeafe,stroke:#1e3a8a,color:#0f172a;
  classDef green fill:#dcfce7,stroke:#166534,color:#0f172a;
  classDef yellow fill:#fef9c3,stroke:#854d0e,color:#0f172a;
  classDef red fill:#fee2e2,stroke:#991b1b,color:#0f172a;
  classDef spine fill:#f8fafc,stroke:#334155,color:#0f172a,stroke-dasharray:4 3;

  class H,AS,I blue
  class E,TG,AB,RB,EC green
  class MCP,A yellow
  class GK,C,P red
  class L spine
