flowchart TB
  %% =========================
  %% LAYER 1 — HUMAN (Blue)
  %% =========================
  subgraph L1["Layer 1 — Human Layer (Blue)"]
    direction TB
    H[Human Agent (H)\n• sovereign meaning/value origin\n• regret owner\n• traits: HSS, SCP]
    AS[Alignment Surface (AS)\n• low ↔ high fidelity interfaces]
    I[Structured Intent Object (I)\n• goal_statement\n• output_spec\n• regret_tolerance\n• constraint_seed C₀\n• budget_envelope B]
  end

  %% =========================
  %% LAYER 2 — ENGINE (Green)
  %% =========================
  subgraph L2["Layer 2 — Symbiosis Engine (Green)"]
    direction TB
    E[Symbiosis Engine (E)\nDeterministic coordinator\nRouter • Planner • Econ Pass • Safety Supervisor]
    TG[Task Graph (TG)\nTyped nodes + dependencies + checkpoints]
    AB[Autonomy Band State (AB0–AB3)\nKernel-enforced autonomy ceiling]
    RB[Regret Boundary (RB)\nReversibility threshold per node]
    EC[Economic Circuit (EC)\nBudget admissibility gate]
  end

  %% =========================
  %% LAYER 3 — AGENTIC (Yellow)
  %% =========================
  subgraph L3["Layer 3 — Agentic Layer (Yellow)"]
    direction TB
    MCP[MCP Contract(s)\nCapabilities • permissions • AB ceiling • cost caps]
    A[Agent Cluster(s) (A)\nCapability modules\n(no goal authority)]
  end

  %% =========================
  %% LAYER 4 — GOVERNANCE (Red)
  %% =========================
  subgraph L4["Layer 4 — Governance Layer (Red)"]
    direction TB
    GK[Governance Kernel (GK)\nRisk classes • RB/AB rules\nConstraint supremacy]
    C[Constraint Vector (C)\n⟨C_legal, C_safety, C_econ⟩\nHard boundary]
    P[Policy Engine / Boards\nSector overlays • audits • escalations]
  end

  %% =========================
  %% CROSS-LAYER SPINE
  %% =========================
  L[Context Lineage (L)\nImmutable ancestry spine\nHashes + replayability]

  %% -------- Control flow DOWN --------
  H --> AS --> I
  I --> E
  E --> EC --> TG
  E --> RB --> AB
  E --> TG --> MCP --> A

  %% -------- Telemetry flow UP --------
  A -. "telemetry: outputs + cost + safety" .-> E
  E -. "updates" .-> L
  E -. "SI / HSS / SCP deltas" .-> H
  E -. "audit + metrics" .-> P

  %% -------- Constraint injection / supremacy --------
  P --> GK
  GK --> C
  C -->|"constraint injection"| E
  C -->|"constraint injection"| TG
  C -->|"caps"| MCP

  %% -------- Styling --------
  classDef blue fill:#dbeafe,stroke:#1e3a8a,stroke-width:1px,color:#0f172a;
  classDef green fill:#dcfce7,stroke:#166534,stroke-width:1px,color:#0f172a;
  classDef yellow fill:#fef9c3,stroke:#854d0e,stroke-width:1px,color:#0f172a;
  classDef red fill:#fee2e2,stroke:#991b1b,stroke-width:1px,color:#0f172a;
  classDef spine fill:#f8fafc,stroke:#334155,stroke-dasharray:4 3,color:#0f172a;

  class H,AS,I blue
  class E,TG,AB,RB,EC green
  class MCP,A yellow
  class GK,C,P red
  class L spine
