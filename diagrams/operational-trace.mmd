flowchart TB

  %% Layer 1 - Human
  subgraph H1["Layer 1 - Human (Blue)"]
    direction LR
    H0[Human defines Intent I0\n+ seed constraints C0\n+ budget B]
    H1a[Human approves Dry Run preview\n(when AB2 or RB proximate)]
    H2[Human reviews RB checkpoints\nand final trace]
  end

  %% Layer 2 - Engine
  subgraph E1["Layer 2 - Engine (Green)"]
    direction LR
    E0[1. Intent Normalization\nI0 to I1]
    E1a[2. Constraint Assembly\nC0 + GK to C]
    E2[3. Planning\nI1 to TG]
    E3[4. Economic Pass\nprice TG vs budget]
    E4[5. RB and AB Selection\ncompute RB, set AB ceiling]
    E5[6. Dry Run Preview\nno side effects]
    E6[7. Dispatch and Bind\nTG to MCP contracts]
    E7[10. Metric Update\nSI, HSS, SCP]
    E8[11. Transparency Trace\nsurface to Human]
    E9[12. Lineage Commit\nhash to L]
  end

  %% Layer 3 - Agentic
  subgraph A1["Layer 3 - Agentic (Yellow)"]
    direction LR
    A0[8. Execute TG nodes\nunder MCP and AB ceiling]
    A1a[9. Return telemetry\noutputs, cost, safety]
  end

  %% Layer 4 - Governance
  subgraph G1["Layer 4 - Governance (Red)"]
    direction LR
    G0[Pre flight Policy Load\nrisk class + AB rules]
    G1a[Violation Gate\nsafe mode or AB demotion]
    G2[Audit Review\nlineage evidence]
  end

  %% Lineage
  L[(Context Lineage Spine L)]

  %% Control flows (downstream)
  H0 --> E0 --> E1a --> E2 --> E3 --> E4
  E4 -->|AB2 or RB prox| E5 --> H1a --> E6 --> A0
  A0 --> A1a

  %% Telemetry flows (upstream)
  A1a -. "telemetry" .-> E7
  E7 -. "transparency" .-> E8 -. "to human" .-> H2
  E7 -. "audit package" .-> E9 -. "hash" .-> L
  L -. "evidence" .-> G2

  %% Governance injection
  G0 --> E1a
  G0 --> E4
  G1a --> E4
  G1a --> E6

  %% Styling
  classDef blue fill:#dbeafe,stroke:#1e3a8a,color:#0f172a;
  classDef green fill:#dcfce7,stroke:#166534,color:#0f172a;
  classDef yellow fill:#fef9c3,stroke:#854d0e,color:#0f172a;
  classDef red fill:#fee2e2,stroke:#991b1b,color:#0f172a;
  classDef spine fill:#f8fafc,stroke:#334155,color:#0f172a,stroke-dasharray:4 3;

  class H0,H1a,H2 blue
  class E0,E1a,E2,E3,E4,E5,E6,E7,E8,E9 green
  class A0,A1a yellow
  class G0,G1a,G2 red
  class L spine
